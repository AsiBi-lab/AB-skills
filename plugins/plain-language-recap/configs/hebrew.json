  "patterns": {
    "testWords": "בדיק|עבר|נכשל|test|pass|fail|✓|✗|ok\\b",
    "testCounts": "(?<![\\d/.])(\\d{1,5})\\s+(?:tests?|checks?|בדיקות)\\b",
    "resultCounts": "(?<![\\d/.–-])(\\d{1,5})\\s+(?:passed|failed|עברו|נכשלו)\\b",
    "notACountBefore": "(?:task|step|phase|משימ|שלב)\\S*\\s*$",
    "failureReported": "(?<!\\d)[1-9]\\d{0,4}\\s+(?:[^\\s.\\d]+\\s+){0,2}?(?:נכשל|failed|failing|failures?)|(?:failed|נכשלו)\\s*[:=]\\s*[1-9]|לא\\s+(?:בדקתי|נבדק|נבדקו|הצלחתי|הרצתי)|דילגתי|\\bskipped\\b",
    "failureMentioned": "נכשל|לא\\s+נבדק|לא\\s+בדקתי|לא\\s+הצלחתי|דילג|לא\\s+עבד|לא\\s+עובד|תקלה|שגיאה|בעיה|failed",
    "checkExplained": "(?:פתחתי|לחצתי|ניסיתי|הפעלתי|השוויתי|הקלדתי|שלחתי|צילמתי|נכנסתי|גללתי)|(?:(?:בדק|בודק|בדיק|וידא|ווידא|מוודא|הרצתי|אימתי|מאמת)[א-ת]*[^.\\n]{0,60}?(?:\\sש[א-ת]|\\sאם\\s|\\sכדי\\s|\\sאיך\\s|:))|(?:לא\\s+בדקתי|לא\\s+נבדק|לא\\s+הרצתי|אין\\s+מה\\s+לבדוק|לא\\s+היה\\s+מה\\s+לבדוק|אי\\s+אפשר\\s+לבדוק|לא\\s+ניתן\\s+לבדוק)"
  },
  "thresholds": {
    "minSectionChars": 380,
    "charsPerChangedFile": 50,
    "maxExtraFiles": 8,
    "minSectionSentences": 5,
    "minBeatChars": 50,
    "maxRawNames": 6,
    "maxSentenceWords": 25,
    "trivialClosingChars": 200
  }
}
