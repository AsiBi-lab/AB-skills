{
  "$comment": "Bundled Hebrew ruleset. Copy to ~/.claude/recap.config.json (or run scripts/use-language.sh) to customise without losing it on update.",
  "language": {
    "name": "Hebrew",
    "script": "hebrew",
    "minRatio": 0.5,
    "minLetters": 40
  },
  "requireBoldHeadings": true,
  "titles": [
    "במילים פשוטות",
    "בפשטות",
    "בשפה פשוטה"
  ],
  "beats": [
    {
      "key": "changed",
      "title": "מה השתנה",
      "labels": [
        "מה השתנה",
        "מה שיניתי",
        "מה עשיתי",
        "מה עשינו",
        "מה נעשה",
        "מה ביצעתי",
        "מה מצאתי",
        "מה נמצא"
      ],
      "covers": "each important change on its own line: what changed, where, and why. Names are fine when you say what the thing does."
    },
    {
      "key": "verified",
      "title": "איך בדקתי ומה יצא",
      "labels": [
        "איך בדקתי ומה יצא",
        "איך בדקתי",
        "מה בדקתי",
        "איך זה נבדק",
        "מה נבדק",
        "איך וידאתי"
      ],
      "covers": "what each check makes sure of, and the real numbers (how many ran, passed, failed). If nothing was checked, say so and why."
    },
    {
      "key": "open",
      "title": "מה עוד לא סגור",
      "labels": [
        "מה עוד לא סגור",
        "מה לא סגור",
        "מה עוד פתוח",
        "מה נשאר פתוח",
        "מה פתוח",
        "מה עלול להשתבש",
        "מה לא בטוח",
        "סיכונים"
      ],
      "covers": "what is unfinished, risky, or uncertain. If nothing, say so in a sentence and why."
    },
    {
      "key": "decide",
      "title": "מה להחליט",
      "labels": [
        "מה להחליט",
        "מה צריך להחליט",
        "מה לעשות עכשיו",
        "מה עכשיו",
        "מה הלאה",
        "הצעד הבא",
        "השלב הבא",
        "הצעדים הבאים"
      ],
      "covers": "what the user should decide, approve, or do now."
    }
  ],
  "jargon": [
    {
      "terms": [
        "commit",
        "commits",
        "קומיט",
        "קומיטים"
      ],
      "plain": "שמירת גרסה"
    },
    {
      "terms": [
        "push",
        "פוש"
      ],
      "plain": "העלאה לשרת שבו הקוד שמור"
    },
    {
      "terms": [
        "merge",
        "מרג'",
        "מרג׳"
      ],
      "plain": "איחוד שינויים"
    },
    {
      "terms": [
        "deploy",
        "deployment",
        "דיפלוי"
      ],
      "plain": "העלאה לאוויר"
    },
    {
      "terms": [
        "branch",
        "בראנץ'",
        "בראנץ׳"
      ],
      "plain": "עותק עבודה נפרד"
    },
    {
      "terms": [
        "repo",
        "repository",
        "ריפו"
      ],
      "plain": "תיקיית הפרויקט"
    },
    {
